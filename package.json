{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "dev:legacy": "tsx server.ts",
    "build:legacy": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start:legacy": "node dist/server.cjs",
    "clean:legacy": "rm -rf dist server.js"
  },
  "dependencies": {
